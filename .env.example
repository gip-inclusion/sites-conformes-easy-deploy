SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,.localhost
HOST_PROTO=http
HOST_URL=localhost
HOST_PORT=8000

# PSQL
PGHOST=127.0.0.1
PGUSER=postgres
PGPORT=5432
PGPASSWORD=password
PGDATABASE=sites_conformes
DATABASE_URL="postgres://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}"

# Service deployed: data-inclusion, mon-recap or site-institutionnel
# SERVICE_NAME=data-inclusion

# S3 media storage (local filesystem is used when S3_HOST is unset)
# S3_HOST=s3.fr-par.scw.cloud
# S3_BUCKET_NAME=my-bucket
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_BUCKET_REGION=fr-par
# S3_PROTOCOL=https
# S3_LOCATION=          # optional prefix inside the bucket
# S3_PUBLIC_HOST=       # optional, public host if different from S3_HOST (e.g. MinIO)
